# Module signing feature knobs and helpers.

[[ -v _install_signing_keys ]] || _install_signing_keys=""

_signing_config() {
  if [[ "$_install_signing_keys" == "true" || -n "${_module_sign_resolved:-}" || ( "${_nvidia_sign:-false}" == "true" && "${_nvidia_pkg:-false}" != "false" ) ]]; then
    msg2 "Enabling module signature support..."
    scripts/config --enable MODULE_SIG || _die "Failed to enable CONFIG_MODULE_SIG."
  fi
}

_signing_resolve() {
  _sign_script="${_kernel_work_folder_abs}/scripts/sign-file"
  _sign_key="$(grep -Po 'CONFIG_MODULE_SIG_KEY="\K[^"]*' "${_kernel_work_folder_abs}/.config")"
  [[ "$_sign_key" =~ ^/ ]] || _sign_key="${_kernel_work_folder_abs}/${_sign_key}"
  _sign_cert="${_kernel_work_folder_abs}/certs/signing_key.x509"
  _sign_hash="$(grep -Po 'CONFIG_MODULE_SIG_HASH="\K[^"]*' "${_kernel_work_folder_abs}/.config")"

  if [[ ! -f "$_sign_key" ]]; then
    warning "Module signing key not found: ${_sign_key}"
    return 1
  elif [[ ! -f "$_sign_cert" ]]; then
    warning "Module signing certificate not found: ${_sign_cert}"
    return 1
  fi

  return 0
}

_install_signing_keys() {
  local _builddir="$1"

  if [[ "$_install_signing_keys" == "true" ]]; then
    _signing_resolve || _die "Cannot install module signing keys: CONFIG_MODULE_SIG=y and a local signing key/certificate are required."

    msg2 "Installing module signing keys..."
    install -Dm400 -- "${_sign_key}" "${_builddir}/certs/signing_key.pem" || _die "Failed to install the module signing key."
    install -Dm644 -- "${_sign_cert}" "${_builddir}/certs/signing_key.x509" || _die "Failed to install the module signing certificate."
  fi
}
