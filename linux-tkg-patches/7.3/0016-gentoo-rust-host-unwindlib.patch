From 67e6654ff08405c7b6a3ddd04336d561401f247b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Christian=20K=C3=BChn?= <damachin3@proton.me>
Date: Wed, 4 Nov 2026 17:31:26 +0100
Subject: [PATCH] kbuild: filter libunwind flags from Rust host links
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Rust selects its own unwinder. Filter Clang's libunwind flags from
Rust host and proc-macro links. Keep the C/C++ linker flags unchanged.

Signed-off-by: Christian Kühn <damachin3@proton.me>
---
 rust/Makefile         | 3 ++-
 scripts/Makefile.host | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/rust/Makefile b/rust/Makefile
index da1a740..b636d65 100644
--- a/rust/Makefile
+++ b/rust/Makefile
@@ -612,12 +612,13 @@ $(obj)/host/libsyn.rlib: private rustc_target_flags = $(syn-flags)
 $(obj)/host/libsyn.rlib: $(src)/syn/lib.rs $(obj)/host/libquote.rlib FORCE
 	+$(call if_changed_dep,rustc_procmacrolibrary)
 
+# Rust selects its own unwinder; Clang's libunwind option is unused here.
 quiet_cmd_rustc_procmacro = $(if $(skip_clippy),RUSTC,$(RUSTC_OR_CLIPPY_QUIET)) P $@
       cmd_rustc_procmacro = \
 	$(rustc_target_envs) \
 	$(if $(skip_clippy),$(RUSTC),$(RUSTC_OR_CLIPPY)) $(rust_common_flags) $(rustc_target_flags) \
 		-Clinker-flavor=gcc -Clinker=$(HOSTCC) \
-		-Clink-args='$(call escsq,$(KBUILD_PROCMACROLDFLAGS))' \
+		-Clink-args='$(call escsq,$(filter-out -unwindlib=libunwind --unwindlib=libunwind,$(KBUILD_PROCMACROLDFLAGS)))' \
 		--emit=dep-info=$(depfile) --emit=link=$@ --extern proc_macro \
 		--crate-type proc-macro -L$(objtree)/$(obj)/host \
 		--crate-name $(patsubst lib%.$(procmacro-extension),%,$(notdir $@)) \
diff --git a/scripts/Makefile.host b/scripts/Makefile.host
index c1dedf6..8769682 100644
--- a/scripts/Makefile.host
+++ b/scripts/Makefile.host
@@ -90,9 +90,10 @@ hostcxx_flags  = -Wp,-MMD,$(depfile) \
 # `--out-dir` is required to avoid temporaries being created by `rustc` in the
 # current working directory, which may be not accessible in the out-of-tree
 # modules case.
+# Rust selects its own unwinder; Clang's libunwind option is unused here.
 hostrust_flags = --out-dir $(dir $@) --emit=dep-info=$(depfile) \
 		 -Clinker-flavor=gcc -Clinker=$(HOSTCC) \
-		 -Clink-args='$(call escsq,$(KBUILD_HOSTLDFLAGS))' \
+		 -Clink-args='$(call escsq,$(filter-out -unwindlib=libunwind --unwindlib=libunwind,$(KBUILD_HOSTLDFLAGS)))' \
                  $(KBUILD_HOSTRUSTFLAGS) $(HOST_EXTRARUSTFLAGS) \
                  $(HOSTRUSTFLAGS_$(target-stem))
 
