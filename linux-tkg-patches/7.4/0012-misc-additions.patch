From 6951de6920b4229fcd23f6023386c4930dbb3e98 Mon Sep 17 00:00:00 2001
From: Steven Barrett <steven@liquorix.net>
Date: Fri, 15 Mar 2024 12:36:51 -0500
Subject: [PATCH 5/7] ZEN: drm/amdgpu/pm: Allow override of min_power_limit
 with ignore_min_pcap

---
 drivers/gpu/drm/amd/amdgpu/amdgpu.h       |  1 +
 drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c   | 10 ++++++++++
 drivers/gpu/drm/amd/pm/amdgpu_pm.c        |  3 +++
 drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c | 11 +++++++----
 4 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu.h b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
index 78a6f7431..80207de4d 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu.h
@@ -159,6 +159,7 @@ struct amdgpu_watchdog_timer {
 extern int amdgpu_modeset;
 extern int amdgpu_iommu_perfopt;
 extern unsigned int amdgpu_vram_limit;
+extern int amdgpu_ignore_min_pcap;
 extern int amdgpu_vis_vram_limit;
 extern int amdgpu_gart_size;
 extern int amdgpu_gtt_size;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index 731fe8f9e..176929db5 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -153,6 +153,7 @@ enum AMDGPU_DEBUG_MASK {
 };
 
 unsigned int amdgpu_vram_limit = UINT_MAX;
+int amdgpu_ignore_min_pcap = 0; /* do not ignore by default */
 int amdgpu_vis_vram_limit;
 int amdgpu_gart_size = -1; /* auto */
 int amdgpu_gtt_size = -1; /* auto */
@@ -278,6 +279,15 @@ struct amdgpu_watchdog_timer amdgpu_watchdog_timer = {
 	.period = 0x0, /* default to 0x0 (timeout disable) */
 };
 
+/**
+ * DOC: ignore_min_pcap (int)
+ * Ignore the minimum power cap.
+ * Useful on graphics cards where the minimum power cap is very high.
+ * The default is 0 (Do not ignore).
+ */
+MODULE_PARM_DESC(ignore_min_pcap, "Ignore the minimum power cap");
+module_param_named(ignore_min_pcap, amdgpu_ignore_min_pcap, int, 0600);
+
 /**
  * DOC: vramlimit (int)
  * Restrict the total amount of VRAM in MiB for testing.  The default is 0 (Use full VRAM).
diff --git a/drivers/gpu/drm/amd/pm/amdgpu_pm.c b/drivers/gpu/drm/amd/pm/amdgpu_pm.c
index 48c52ac0f..d164a837d 100644
--- a/drivers/gpu/drm/amd/pm/amdgpu_pm.c
+++ b/drivers/gpu/drm/amd/pm/amdgpu_pm.c
@@ -3446,6 +3446,9 @@ static ssize_t amdgpu_hwmon_show_power_cap_min(struct device *dev,
 					 struct device_attribute *attr,
 					 char *buf)
 {
+	if (amdgpu_ignore_min_pcap)
+		return sysfs_emit(buf, "%i\n", 0);
+
 	return amdgpu_hwmon_show_power_cap_generic(dev, attr, buf, PP_PWR_LIMIT_MIN);
 }
 
diff --git a/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c b/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c
index c9fe323fa..63548afd4 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c
@@ -3090,9 +3090,12 @@ int smu_get_ppt_limit(void *handle,
 			smu->ppt_limits.range[power_source][limit_type].max;
 		break;
 	case SMU_PPT_LIMIT_MIN:
-		*limit = smu->od_enabled ?
-			smu->ppt_limits.range[power_source][limit_type].od_min :
-			smu->ppt_limits.range[power_source][limit_type].min;
+		if (amdgpu_ignore_min_pcap)
+			*limit = 0;
+		else
+			*limit = smu->od_enabled ?
+				smu->ppt_limits.range[power_source][limit_type].od_min :
+				smu->ppt_limits.range[power_source][limit_type].min;
 		break;
 	default:
 		return -EINVAL;
@@ -3129,7 +3132,7 @@ static int smu_set_ppt_limit(void *handle, uint32_t limit_type, uint32_t limit)
 			return ret;
 	}
 
-	if (limit > max_limit || limit < min_limit) {
+	if (limit > max_limit || (limit < min_limit && !amdgpu_ignore_min_pcap)) {
 		dev_err(smu->adev->dev,
 			"New PPT limit (%d) is out of range [%d,%d]\n",
 			limit, min_limit, max_limit);

From 7b951af84112bcfea84bf8f6d32505c3fd805630 Mon Sep 17 00:00:00 2001
From: Eric Naim <dnaim@cachyos.org>
Date: Tue, 15 Sep 2026 10:05:48 +0800
Subject: [PATCH 6/7] Revert "drm/gud: validate TV mode names before creating
 enum property"

This reverts commit da1ea35fea67ad841f4ada28dd61b41be65e5437.
This commit breaks compiling with clang 22.1.8 -O3.

Since the prior commit already mitigates the issue, reverting this
should be fine until clang gets updated in Arch Linux/CachyOS.

Signed-off-by: Eric Naim <dnaim@cachyos.org>
---
 drivers/gpu/drm/gud/gud_connector.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/gud/gud_connector.c b/drivers/gpu/drm/gud/gud_connector.c
index 8141c3a1e..5c0065c87 100644
--- a/drivers/gpu/drm/gud/gud_connector.c
+++ b/drivers/gpu/drm/gud/gud_connector.c
@@ -399,11 +399,8 @@ static int gud_connector_add_tv_mode(struct gud_device *gdrm, struct drm_connect
 	for (i = 0; i < num_modes; i++) {
 		char *mode = &buf[i * GUD_CONNECTOR_TV_MODE_NAME_LEN];
 
-		if (!memchr(mode, '\0', GUD_CONNECTOR_TV_MODE_NAME_LEN)) {
-			ret = -EIO;
-			goto free;
-		}
-
+		/* The device is not trusted to NUL-terminate the name */
+		mode[GUD_CONNECTOR_TV_MODE_NAME_LEN - 1] = '\0';
 		modes[i] = mode;
 	}
 

From 962bee17a9d7d5cd3369b70c0914fe050b66b948 Mon Sep 17 00:00:00 2001
From: Peter Jung <admin@ptr1337.dev>
Date: Mon, 02 Nov 2026 10:31:47 +0000
Subject: [PATCH 7/7] rust: Allow BTF generation with Rust + LTO

Commit 5daa0c35a1f0 ("rust: Disallow BTF generation with Rust + LTO")
keeps RUST off when LTO and DEBUG_INFO_BTF are both enabled. Our default
kernel is built with Clang ThinLTO and needs BTF for sched_ext and the
BPF tooling, so olddefconfig silently drops RUST, and with it the Rust
abstractions and the DRM panic QR code.

With pahole 1.32, the BTF of a ThinLTO vmlinux with Rust built in is
fine. Rust modules are what fails: when pahole merges the CUs of an LTO
object, the merged CU takes the language of the first CU, which is the
Rust one for Rust modules. --lang_exclude=rust then drops the whole
merged CU, and gen-btf.sh fails:

  FAILED: load BTF from samples/rust/rust_minimal.ko.BTF.1: No such file or directory

This is fixed in pahole by the series "dwarf_loader: Fix --lang_exclude
on merged CUs", which is not in a release yet and does not bump the
version, so the dependency cannot be gated on PAHOLE_VERSION. Drop the
!LTO part of it and build with a pahole that carries these fixes.

Tested with Clang 23 and rustc 1.99 on x86_64 ThinLTO with DWARF 5,
DEBUG_INFO_BTF_MODULES and MODULE_ALLOW_BTF_MISMATCH=n: the vmlinux and
C module BTF are the same as with stock pahole, the Rust sample modules
and rnull get BTF and load, and scx_bpfland and scx_cosmos attach.

Link: https://lore.kernel.org/all/20261010005227.976-1-linux@alanderk.com/
Signed-off-by: Peter Jung <admin@ptr1337.dev>
---
 init/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/init/Kconfig b/init/Kconfig
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -2280,7 +2280,7 @@ config RUST
 	depends on !MODVERSIONS || GENDWARFKSYMS
 	depends on !GCC_PLUGIN_RANDSTRUCT
 	depends on !RANDSTRUCT
-	depends on !DEBUG_INFO_BTF || (PAHOLE_HAS_LANG_EXCLUDE && !LTO)
+	depends on !DEBUG_INFO_BTF || PAHOLE_HAS_LANG_EXCLUDE
 	depends on !CFI || HAVE_CFI_ICALL_NORMALIZE_INTEGERS_RUSTC
 	select CFI_ICALL_NORMALIZE_INTEGERS if CFI
 	depends on !KASAN || CC_IS_CLANG
