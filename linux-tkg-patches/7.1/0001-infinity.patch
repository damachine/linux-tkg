From 9ceb8a6d322c5090acffa7c62a00ee3a34197101 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 28 Jul 2026 07:12:37 +0700
Subject: [PATCH 16/47] v4.7-gpu: add GPU job-type awareness to reduce
 compositor penalty

Track per-entity submission interval in gpu_last_submit_interval.
Entities submitting jobs every 1-8ms (compositor-like) get a 25%
reduction in the EMA burst penalty, while infrequent submitters
(compute-like) keep the full penalty.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 25 +++++++++++++++++++++++++
 include/drm/gpu_scheduler.h            | 10 ++++++++++
 2 files changed, 35 insertions(+)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 0c63be524..39b0e99c2 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -261,6 +261,22 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 					INFINITY_GPU_EMA_CLIMB_NS);
 		u64 boost = vtime * ema_pct / 100;
 
+		/* GPU job-type awareness: entities that submit jobs
+		 * frequently (every 1-8ms) follow a compositor-like
+		 * pattern -- many small, short-lived jobs.  These
+		 * should not be penalized as heavily as a compute
+		 * entity submitting large, infrequent jobs.
+		 *
+		 * Reduce the burst penalty by 25% when the submission
+		 * interval is under 8ms (INFINITY_GPU_FAST_SUBMIT_NS).
+		 * This gives a smoother desktop experience during GPU
+		 * compositing while keeping the full penalty for batch
+		 * workloads.
+		 */
+		if (entity->gpu_last_submit_interval > 0 &&
+		    entity->gpu_last_submit_interval < INFINITY_GPU_FAST_SUBMIT_NS)
+			boost -= boost >> 2;
+
 		vtime += boost >> 1;
 	}
 
@@ -326,6 +342,15 @@ void drm_sched_rq_update_vtime_locked(struct drm_sched_entity *entity,
 		else if (periods)
 			entity->gpu_time_ema >>= periods;
 	}
+	/* Track submission interval for job-type awareness */
+	if (entity->gpu_time_last_active) {
+		u64 interval = ktime_to_ns(ktime_sub(ts,
+			entity->gpu_time_last_active));
+
+		entity->gpu_last_submit_interval = interval;
+	} else {
+		entity->gpu_last_submit_interval = 0;
+	}
 	entity->gpu_time_last_active = ts;
 
 	entity->cached_gpu_vtime = drm_sched_entity_calc_vtime(entity);
diff --git a/include/drm/gpu_scheduler.h b/include/drm/gpu_scheduler.h
index bdaf46ba3..232a2c7b5 100644
--- a/include/drm/gpu_scheduler.h
+++ b/include/drm/gpu_scheduler.h
@@ -255,6 +255,15 @@ struct drm_sched_entity {
 	 */
 	ktime_t				gpu_time_last_active;
 
+	/**
+	 * @gpu_last_submit_interval: ns since previous submission.
+	 * Used for submission profile detection in calc_vtime().
+	 * Values below ~8ms indicate a compositor-like (tight loop)
+	 * pattern, which reduces the EMA burst penalty proportionally.
+	 * Written under rq->lock in drm_sched_rq_update_vtime_locked().
+	 */
+	u64				gpu_last_submit_interval;
+
