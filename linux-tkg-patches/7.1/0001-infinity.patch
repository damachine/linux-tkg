From 9e524df3089ff8ee46010e0af1f0e5cc95630636 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 1 Aug 2026 06:31:28 +0700
Subject: [PATCH 23/47] v4.7-gpu: apply cgroup EMA decay when a migrated task
 ends an idle period

The group EMA idle window (group_ema_sleep_start) was only consumed on
ENQUEUE_WAKEUP.  When a task arrived via ENQUEUE_MIGRATED, the window
was left pending, so a later wakeup decay spanned an inflated period
that included time the cfs_rq was already non-empty, under-decaying the
group EMA.

Consume the idle window on migration arrival as well, so the decay
reflects the actual idle duration of the cfs_rq.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c | 40 +++++++++++++++++++++-------------------
 1 file changed, 21 insertions(+), 19 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 0b6f803f7..bd1ab7691 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7325,28 +7325,30 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 
 		if (p->infinity.last_sleep_ns && now > p->infinity.last_sleep_ns)
 			infinity_wakeup(&p->infinity, now - p->infinity.last_sleep_ns);
+	}
 #ifdef CONFIG_FAIR_GROUP_SCHED
-		/*
-		 * Group EMA decay: if this cfs_rq was idle (sleep_start set)
-		 * and we're the first task re-entering, apply exponential decay
-		 * using the elapsed idle time.
-		 */
-		{
-			struct cfs_rq *pcfs_rq = cfs_rq_of(&p->se);
-
-			if (pcfs_rq->group_ema_sleep_start) {
-				u64 sleep_ns = now - pcfs_rq->group_ema_sleep_start;
-				u64 periods = div64_u64(sleep_ns,
-					INFINITY_CGROUP_EMA_HALFLIFE_NS);
-				if (periods > 63)
-					pcfs_rq->group_ema = 0;
-				else
-					pcfs_rq->group_ema >>= periods;
-				pcfs_rq->group_ema_sleep_start = 0;
-			}
+	/*
+	 * Group EMA decay: if this cfs_rq was idle (sleep_start set) and a
+	 * task is (re)entering, apply exponential decay using the elapsed
+	 * idle time.  Also covers ENQUEUE_MIGRATED so the idle window is
+	 * not deferred past the end of the idle period.
+	 */
+	if (flags & (ENQUEUE_WAKEUP | ENQUEUE_MIGRATED)) {
+		struct cfs_rq *pcfs_rq = cfs_rq_of(&p->se);
+
+		if (pcfs_rq->group_ema_sleep_start) {
+			u64 now = rq_clock(rq_of(pcfs_rq));
+			u64 sleep_ns = now - pcfs_rq->group_ema_sleep_start;
+			u64 periods = div64_u64(sleep_ns,
+				INFINITY_CGROUP_EMA_HALFLIFE_NS);
+			if (periods > 63)
+				pcfs_rq->group_ema = 0;
+			else
+				pcfs_rq->group_ema >>= periods;
+			pcfs_rq->group_ema_sleep_start = 0;
 		}
-#endif
 	}
+#endif
 	int h_nr_idle = task_has_idle_policy(p);
 	int h_nr_runnable = 1;
 	int task_new = !(flags & ENQUEUE_WAKEUP);
