From d5fa1125698e92b2e47010ae487f59f0494e2ae3 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sun, 26 Jul 2026 16:16:18 +0700
Subject: [PATCH 06/47] v4.6-gpu: eliminate two-lock-domain data race in GPU
 time accounting

Replace the direct gpu_time_total/gpu_time_ema writes in
drm_sched_get_finished_job() (under job_list_lock) with a lock-free
atomic64 accumulator on the entity.  The pending ns is drained under
rq->lock in drm_sched_rq_update_vtime_locked(), making all entity
field accesses consistently under rq->lock rather than split across
two independent spinlocks:

  - drm_sched_job_done(): WRITE_ONCE(s_job->infinity_gpu_ns, ...)
    unchanged -- fence callback, IRQ-safe, no locks

  - drm_sched_get_finished_job(): READ_ONCE(infinity_entity) +
    READ_ONCE(infinity_gpu_ns) + atomic64_add to entity->pending_gpu_ns

  - drm_sched_rq_update_vtime_locked(): atomic64_xchg + drain to
    gpu_time_total and gpu_time_ema (under rq->lock -- consistent
    with calc_vtime reads)

New entity field: pending_gpu_ns (atomic64_t)
Per-job infinity_gpu_ns is retained as transient carrier from job_done
to get_finished_job; the data now flows through the entity accumulator
rather than being applied directly.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 52 ++++++++++++++++++--------
 include/drm/gpu_scheduler.h            | 29 ++++++++------
 2 files changed, 55 insertions(+), 26 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index e791b170f..704a163cf 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -216,6 +216,35 @@ void drm_sched_rq_update_vtime_locked(struct drm_sched_entity *entity,
 	drm_sched_rq_remove_vtime_locked(entity, rq);
 	entity->oldest_job_waiting = ts;
 
+	/* Infinity: drain pending GPU time accounting from completed jobs.
+	 * atomic64_xchg with full barrier pairs with atomic64_add in
+	 * drm_sched_get_finished_job().  All gpu_time_total and gpu_time_ema
+	 * updates now happen under rq->lock -- no two-lock-domain race.
+	 */
+	{
+		u64 pending_ns = atomic64_xchg(&entity->pending_gpu_ns, 0);
+		u64 climb_ns;
+
+		if (pending_ns) {
+			entity->gpu_time_total += pending_ns;
+
+			/* EMA climb -- clamp total to EMA_CLIMB_NS so a
+			 * single large drain doesn't spike the EMA.
+			 */
+			climb_ns = pending_ns;
+			if (climb_ns > INFINITY_GPU_EMA_CLIMB_NS)
+				climb_ns = INFINITY_GPU_EMA_CLIMB_NS;
+
+			entity->gpu_time_ema += div64_u64(
+				(INFINITY_GPU_EMA_CLIMB_NS -
+				 entity->gpu_time_ema) *
+				climb_ns * INFINITY_GPU_EMA_ALPHA,
+				INFINITY_GPU_EMA_CLIMB_NS * (1ULL << 8));
+
+			atomic_inc(&infinity_gpu_accounting_applied);
+		}
+	}
+
 	/* Infinity EMA decay on idle */
 	if (entity->gpu_time_last_active) {
 		u64 idle_ns = ktime_to_ns(ktime_sub(ts,
@@ -1167,7 +1196,11 @@ drm_sched_get_finished_job(struct drm_gpu_scheduler *sched, bool *have_more)
 
 		/* Infinity: deferred GPU time accounting.
 		 * job_list_lock protects against concurrent infinity_entity
-		 * cleanup in drm_sched_entity_kill().
+		 * cleanup in drm_sched_entity_kill().  GPU ns is moved to
+		 * the entity's pending_gpu_ns accumulator (lock-free
+		 * atomic64) for later draining under rq->lock in
+		 * drm_sched_rq_update_vtime_locked().  This eliminates the
+		 * two-lock-domain data race between job_list_lock and rq->lock.
 		 */
 		{
 			struct drm_sched_entity *inf_entity;
@@ -1176,20 +1209,9 @@ drm_sched_get_finished_job(struct drm_gpu_scheduler *sched, bool *have_more)
 			inf_entity = READ_ONCE(job->infinity_entity);
 			gpu_ns = READ_ONCE(job->infinity_gpu_ns);
 			if (inf_entity) {
-				/* gpu_ns may be 0 for zero-duration jobs
-				 * (fast queues, simulators).  Accounting
-				 * update with 0 is a no-op on the entity
-				 * fields but still counts as applied.
-				 */
-				if (gpu_ns) {
-					inf_entity->gpu_time_total += gpu_ns;
-					inf_entity->gpu_time_ema += div64_u64(
-						(INFINITY_GPU_EMA_CLIMB_NS -
-						 inf_entity->gpu_time_ema) *
-						gpu_ns * INFINITY_GPU_EMA_ALPHA,
-						INFINITY_GPU_EMA_CLIMB_NS *
-						(1ULL << 8));
-				}
+				if (gpu_ns)
+					atomic64_add(gpu_ns,
+						     &inf_entity->pending_gpu_ns);
 				atomic_inc(&infinity_gpu_accounting_applied);
 			} else {
 				atomic_inc(&infinity_gpu_accounting_skipped);
diff --git a/include/drm/gpu_scheduler.h b/include/drm/gpu_scheduler.h
index 99b16a86f..19a835846 100644
--- a/include/drm/gpu_scheduler.h
+++ b/include/drm/gpu_scheduler.h
@@ -25,6 +25,7 @@
 #define _DRM_GPU_SCHEDULER_H_
 
 #include <drm/spsc_queue.h>
+#include <linux/atomic.h>
 #include <linux/dma-fence.h>
 #include <linux/completion.h>
 #include <linux/xarray.h>
@@ -235,26 +236,21 @@ struct drm_sched_entity {
 
 	/**
 	 * @gpu_time_ema: Infinity EMA of GPU time consumed.
-	 * Unit: ns, ceiling ~10ms. Written under sched->job_list_lock on
-	 * completion (drm_sched_get_finished_job); read under rq->lock during
-	 * scheduling (drm_sched_entity_calc_vtime).  EMA is a heuristic —
-	 * stale reads self-correct.
+	 * Unit: ns, ceiling ~10ms.  Written and read under rq->lock.
+	 * Accumulated from pending_gpu_ns in drm_sched_rq_update_vtime_locked().
 	 */
 	u64				gpu_time_ema;
 
 	/**
-	 * @gpu_time_total: Total GPU time consumed (cumulative). Written under
-	 * sched->job_list_lock on completion; read under rq->lock during
-	 * scheduling.  Stale reads degrade fairness temporarily but the
-	 * cumulative value converges as more jobs complete.
+	 * @gpu_time_total: Total GPU time consumed (cumulative).
+	 * Written and read under rq->lock.
+	 * Accumulated from pending_gpu_ns in drm_sched_rq_update_vtime_locked().
 	 */
 	u64				gpu_time_total;
 
 	/**
 	 * @gpu_time_last_active: ktime when entity last had a job submitted.
-	 * Used for EMA decay on idle. Written under rq->lock in the
-	 * scheduling path; read under rq->lock.  Not accessed by the
-	 * completion path.
+	 * Used for EMA decay on idle.  Written and read under rq->lock.
 	 */
 	ktime_t				gpu_time_last_active;
 
@@ -263,6 +259,17 @@ struct drm_sched_entity {
 	 * Protected by rq->lock.
 	 */
 	u64				cached_gpu_vtime;
+
+	/**
+	 * @pending_gpu_ns: GPU ns from completed jobs, awaiting rq->lock.
+	 *
+	 * Written atomically in drm_sched_get_finished_job() (under
+	 * job_list_lock).  Drained under rq->lock in
+	 * drm_sched_rq_update_vtime_locked() via atomic64_xchg.
+	 * Eliminates the two-lock-domain data race between job_list_lock
+	 * (completion path) and rq->lock (scheduling path).
+	 */
+	atomic64_t			pending_gpu_ns;
 };
 
