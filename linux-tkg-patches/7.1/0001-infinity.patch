From e16505a02ac5dc84009b600222d978504f702401 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 14:33:01 +0700
Subject: [PATCH 27/47] v4.8-gpu: boost interactive IPC wakeups from
 wait_woken()

The futex boost only covers futex_do_wait() waits.  The IPC paths that
games and browsers actually use - sockets (sk_wait_event), fsnotify,
tty, NFS/Ceph - sleep through wait_woken(), so extend the interactive
wakeup signal there: wait_woken() sets ipc_waiting around the sleep,
and place_entity() shortens the wakee's deadline with a sleep-duration
gradient (full 2x vslice reduction at <= 1ms sleep, linear falloff to
no boost at >= 8ms), the same EEVDF placement lever the futex boost
uses.  A per-task rate limit of one boost per 2ms bounds per-packet
wakeup storms deterministically, and the eligibility invariant is
unchanged - the boost never overrides EEVDF eligibility.  The stats
funnel exposes the mechanism: 'IPC wakeups' counts all wait_woken
candidates, 'IPC boosts' the rate-limit-passing boosts.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  2 ++
 kernel/sched/fair.c           | 28 ++++++++++++++++++++++++++++
 kernel/sched/infinity_sched.c | 27 +++++++++++++++++++++++++--
 kernel/sched/infinity_sched.h | 32 ++++++++++++++++++++++++++++++++
 kernel/sched/wait.c           |  6 +++++-
 5 files changed, 92 insertions(+), 3 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 5c7d97f9a..d048c3863 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -823,6 +823,8 @@ struct infinity_ctx {
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
 	bool		futex_waiting;
+	bool		ipc_waiting;
+	u64		ipc_last_boost;	/* Last IPC boost timestamp (ns) */
 
 	/**
 	 * @gpu_passovers: GPU scheduling pass-over count.
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index c82bb19ce..5af9b1a90 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5604,6 +5604,34 @@ place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 		atomic64_inc(this_cpu_ptr(&infinity_futex_boost_count));
 	}
 
+	if (entity_is_task(se) && (flags & ENQUEUE_WAKEUP) &&
+	    task_of(se)->infinity.ipc_waiting &&
+	    !(task_of(se)->flags & PF_KTHREAD)) {
+		/* Infinity: IPC candidates -- all wait_woken wakeups. */
+		u64 now = rq_clock(rq_of(cfs_rq));
+		u64 last_boost = READ_ONCE(task_of(se)->infinity.ipc_last_boost);
+
+		atomic64_inc(this_cpu_ptr(&infinity_ipc_wakeup_count));
+		if (!last_boost ||
+		    (now > last_boost &&
+		     now - last_boost >= INFINITY_IPC_RATE_LIMIT_NS)) {
+			/* IPC boost gradient -- full 2x at sleep <= 1ms,
+			 * linear falloff to 1x at >= 8ms.
+			 */
+			u64 last_sleep = READ_ONCE(task_of(se)->infinity.last_sleep_ns);
+			u64 sleep_ns = (last_sleep && now > last_sleep) ?
+				       now - last_sleep : 0;
+			u64 red = infinity_ipc_gradient(sleep_ns);
+
+			if (red) {
+				vslice -= (vslice * red) >> INFINITY_FP_SHIFT;
+				WRITE_ONCE(task_of(se)->infinity.ipc_last_boost,
+					   now);
+				atomic64_inc(this_cpu_ptr(&infinity_ipc_boost_count));
+			}
+		}
+	}
+
 	/*
 	 * EEVDF: vd_i = ve_i + r_i/w_i
 	 */
