index 20f27e2cf..f66b804e6 100644
--- a/kernel/sched/wait.c
+++ b/kernel/sched/wait.c
@@ -438,8 +438,12 @@ long wait_woken(struct wait_queue_entry *wq_entry, unsigned mode, long timeout)
 	 * or woken_wake_function() sees our store to current->state.
