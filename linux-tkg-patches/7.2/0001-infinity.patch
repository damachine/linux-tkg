From 718e533d3088f75b8d0bf8b581d5bf5574f333d0 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 18:30:43 +0700
Subject: [PATCH 32/39] v4.8-gpu: reset scheduler state on exec

exec() reuses the same task_struct, so a freshly exec'd image inherited
the previous image's EMA penalty, RT valve state, IPC rate limit and
divergence streak -- a suid program could be born already classified as a
hog.  infinity_exec_reset() clears the per-image state and sched_exec()
calls it before the migration decision, so every exec starts from a clean
scheduler slate (fork() already reinitializes everything for new tasks).

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/core.c           |  3 +++
 kernel/sched/infinity_sched.c | 19 +++++++++++++++++++
 kernel/sched/infinity_sched.h |  1 +
 3 files changed, 23 insertions(+)

diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 65096617f..91f46f56a 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -5633,6 +5633,9 @@ void sched_exec(void)
 	struct migration_arg arg;
 	int dest_cpu;
 
+	/* Infinity: exec() starts a new image -- reset per-image scheduler state */
+	infinity_exec_reset(&p->infinity);
+
 	scoped_guard (raw_spinlock_irqsave, &p->pi_lock) {
 		dest_cpu = p->sched_class->select_task_rq(p, task_cpu(p), WF_EXEC);
 		if (dest_cpu == smp_processor_id())
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index d1d1e1c73..47113211a 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -605,6 +605,25 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->rt_valve_last_jiffies = 0;
 	ctx->divergence_streak = 0;
 }
+
+/* ------------------------------------------------------------------ */
+/* infinity_exec_reset -- clear per-image scheduler state on exec       */
+/* ------------------------------------------------------------------ */
+void infinity_exec_reset(struct infinity_ctx *ctx)
+{
+	/* exec() reuses the same task: the previous image's EMA penalty,
+	 * RT valve state, IPC rate limit and divergence streak must not
+	 * carry over into the new image (fork() already reinitializes
+	 * everything for new tasks).
+	 */
+	WRITE_ONCE(ctx->ema, 0);
+	WRITE_ONCE(ctx->rt_ema, 0);
+	WRITE_ONCE(ctx->ipc_last_boost, 0);
+	WRITE_ONCE(ctx->rt_valve_armed, false);
+	WRITE_ONCE(ctx->rt_valve_last_jiffies, 0);
+	ctx->divergence_streak = 0;
+}
+
 /* ------------------------------------------------------------------ */
 /* (Removed in v4.5: carriage_ns, auto_carriage_ns, two-pole,          *
  *  prev_ema, infinity_slice, infinity_vruntime_scale,                  *
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 1e8202c32..8a4ef9e14 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -235,6 +235,7 @@ DECLARE_PER_CPU(atomic64_t, infinity_divergence_count);
 void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns, unsigned long cpu_capacity);
 void infinity_wakeup(struct infinity_ctx *ctx, u64 sleep_ns);
 void infinity_fork_init(struct infinity_ctx *ctx, u64 now);
+void infinity_exec_reset(struct infinity_ctx *ctx);
 void infinity_rt_consume(struct infinity_ctx *ctx, u64 delta_ns);
 void infinity_rt_wakeup(struct infinity_ctx *ctx, u64 sleep_ns);
 unsigned int infinity_rr_timeslice(struct task_struct *p,
