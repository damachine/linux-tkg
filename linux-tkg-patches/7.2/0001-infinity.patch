From 4c5de922f6320fc802aa3020b0944fa48e357f4e Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 28 Jul 2026 07:12:36 +0700
Subject: [PATCH 06/39] v4.7-gpu: add EMA-driven cpufreq hint for interactive
 wakeups

Add SCHED_CPUFREQ_INTERACTIVE flag alongside the existing IOWAIT flag.
When a task with EMA == 0 (fully interactive) wakes up, set the flag
so schedutil applies the same frequency ramp as IO-wait tasks.

This catches interactive wakeups from futex, timer, and other non-IO
sources that previously got no frequency boost.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched/cpufreq.h    |  1 +
 kernel/sched/cpufreq_schedutil.c | 12 +++++++++---
 kernel/sched/fair.c              | 26 +++++++++++++++++++++++---
 3 files changed, 33 insertions(+), 6 deletions(-)

diff --git a/include/linux/sched/cpufreq.h b/include/linux/sched/cpufreq.h
index bdd31ab93..336dc2366 100644
--- a/include/linux/sched/cpufreq.h
+++ b/include/linux/sched/cpufreq.h
@@ -9,6 +9,7 @@
  */
 
 #define SCHED_CPUFREQ_IOWAIT	(1U << 0)
+#define SCHED_CPUFREQ_INTERACTIVE	(1U << 1)
 
 #ifdef CONFIG_CPU_FREQ
 struct cpufreq_policy;
diff --git a/kernel/sched/cpufreq_schedutil.c b/kernel/sched/cpufreq_schedutil.c
index dff4ee046..991d7f653 100644
--- a/kernel/sched/cpufreq_schedutil.c
+++ b/kernel/sched/cpufreq_schedutil.c
