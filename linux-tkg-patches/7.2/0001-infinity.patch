 	if (write && ret == 0) {
-		unsigned long val;
-
 		val = READ_ONCE(infinity_tune_smt_divisor);
-		val = clamp(val, INFINITY_SMT_DIVISOR_MIN, INFINITY_SMT_DIVISOR_MAX);
 		if (val != old)
